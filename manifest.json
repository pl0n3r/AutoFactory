{
  "manifest_version": 3,
  "name": "ChatGPT Autopilot Local",
  "version": "1.6.26",
  "description": "Continúa chats usando el campo y botón reales del HTML, sin coordenadas de pantalla.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "ChatGPT Autopilot Local",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "autopilot-core.js",
        "account-budget-guard.js",
        "learning.js",
        "reliability.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}
